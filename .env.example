# 复制为 .env 后填写实际的远程基础设施地址。不要提交 .env。
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_NAME=sugar_health
DB_USERNAME=glucopilot
DB_PASSWORD=replace-with-strong-password
DB_SSL_ENABLED=false

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace-with-strong-password
REDIS_SSL_ENABLED=false
REDIS_TIMEOUT=3s

# 若依后台 JWT 签名密钥：必须至少 64 字节随机字符串，不得沿用演示密钥。
OPS_TOKEN_SECRET=
RUOYI_UPLOAD_PATH=/app/uploads

# 对外只暴露 Nginx；后端仅在 Docker 网络中监听 8080。
HTTP_PORT=80
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC

# ---------------------------------------------------------------------------
# 对象存储：生产走阿里云 OSS（见 backend/glucopilot-business/src/main/resources/application-prod.yaml）
# 缺任一项 → 上传凭证/登记媒体接口不可用（OSS 客户端会拿到空 endpoint/空桶）
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=aliyun-oss
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
OSS_BUCKET=glucopilot-prod
OSS_REGION=cn-hangzhou

# ---------------------------------------------------------------------------
# AI：DeepSeek Key；也可在 application-local.yaml 配置 spring.ai.deepseek.api-key。
# ---------------------------------------------------------------------------
AI_DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# ---------------------------------------------------------------------------
# AI 视觉（多模态）：阿里云百炼 qwen-vl，OpenAI 兼容端点。
# 对应 application.yaml 的 ai.vision.*（注意不是 spring.ai.openai.*，本模块刻意不引该 starter）。
# 本机非容器运行不需要在这里配 —— 放 application-local.yaml（已 gitignore）即可。
# 模型名务必用本账号实际开通的（用 /compatible-mode/v1/models 查）：
# 实测 qwen-vl-max 与 qwen3-vl-flash 在某些账号下不存在，会报 404 Model not exist。
# ---------------------------------------------------------------------------
AI_VISION_ENABLED=false
AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VISION_API_KEY=replace-with-your-bailian-api-key
AI_VISION_MODEL=qwen3-vl-plus

# ---------------------------------------------------------------------------
# 后台模型配置的加密主密钥（AES-256-GCM）：用于解密 ai_model_config.api_key_cipher。
# 建议 32 字节随机值（base64 或任意 32 字符），用 `openssl rand -base64 32` 生成。
# 缺失时的行为（刻意如此）：不解密、相关配置整行跳过并 WARN，回落到 yaml/环境变量，
#   应用照常启动（本地开发不被挡住）；但后台上传密钥会被明确拒绝，绝不会降级成明文存储。
# 轮换：换值后需要重新在后台录入各模型密钥；旧密文将无法解密（会走上面的回落路径）。
# ---------------------------------------------------------------------------
AI_CONFIG_MASTER_KEY=

API_IMAGE=glucopilot-api:accepted-tag

# Set none to deploy without a DeepSeek key.
SPRING_AI_MODEL_CHAT=deepseek

# Course deployment without object storage: STORAGE_PROVIDER=disabled
