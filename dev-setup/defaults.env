# =============================================================================
# 本机后端默认可编辑配置（可提交）。在 backend 根目录执行：
#   双击 dev-setup\一键配置.cmd
#   或：powershell -ExecutionPolicy Bypass -File .\dev-setup\setup-backend-dev.ps1 -Force
# 生成的 .env / application-local.yaml 勿提交。
# =============================================================================

# ----- MySQL (local) -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sugar_health
DB_USERNAME=root
DB_PASSWORD=123456
DB_SSL_ENABLED=false

# ----- Redis (local) -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_TIMEOUT=3s

# ----- RuoYi JWT: at least 64 chars; local demo value, replace if you want -----
OPS_TOKEN_SECRET=zEY6GNiuSRHsWx/GFsfgBbdOoGtxj48/7IDGuVy2I+xEta67wt1OyMqYGrUBmMziGwJOZp0HKVkJAuAZHbeoYA==
RUOYI_UPLOAD_PATH=./data/ruoyi-uploads

# ----- Object storage: local by default; -WithMinio sets STORAGE_PROVIDER=minio -----
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./data/uploads
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=glucopilot

# ----- WeChat mock: empty = openid from code hash; set to pin one dev user -----
WECHAT_MOCK_FIXED_OPENID=

# ----- Mail (optional) -----
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SSL_ENABLED=false
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true

# ----- AI (optional / placeholder) -----
AI_DEEPSEEK_API_KEY=sk-dummy-key-for-local-dev
AI_VISION_ENABLED=false
AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VISION_API_KEY=
AI_VISION_MODEL=qwen3-vl-plus
AI_CONFIG_MASTER_KEY=

SPRING_AI_MODEL_CHAT=deepseek
