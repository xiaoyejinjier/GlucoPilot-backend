<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.threadfit.glucopilot.user.mapper.FeedbackTypeMapper">
    <select id="selectTypes" resultType="com.threadfit.glucopilot.user.dto.FeedbackDtos$TypeItem">
        SELECT id, name, device_related
        FROM feedback_type
        <if test="enabledOnly">WHERE enabled = 1</if>
        ORDER BY sort_no, id
    </select>
</mapper>
